{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "awesomemaps.vercel.app" }],
      "destination": "https://awesomemaps.diegoramosretamal.info/$1",
      "permanent": true
    }
  ]
}
